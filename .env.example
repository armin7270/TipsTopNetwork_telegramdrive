# ==============================================================================
# TeleDrive Production Configuration (.env)
# ==============================================================================

# Environment mode (production / development)
TELEDRIVE_ENV=production
TELEDRIVE_IN_MEMORY=1
TELEDRIVE_FAKE_TELEGRAM=0

# Cryptography & Token Keys (Base64-encoded 32-byte random keys)
# You can generate new keys using: openssl rand -base64 32
MASTER_KEK=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_SECRET=dGVzdC1zZWNyZXQtdGhhdC1pcy1sb25nLWVub3VnaC0zMmI=

# Telegram Bot Credentials
# Obtain your Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram MTProto Client API Credentials
# Official defaults (API ID 6) can be used, or get your own from https://my.telegram.org
TELEGRAM_API_ID=6
TELEGRAM_API_HASH=eb06d4abfb49dc3eeb1aeb98ae0f581e

# Private Telegram Storage Channel ID (Format: -100xxxxxxxxxx)
# IMPORTANT: The bot MUST be added as an Administrator with "Post Messages" permission in this channel!
STORAGE_POOL_CHANNEL_IDS=-1001234567890

# Performance & Streaming Parameters
STORAGE_CHUNK_SIZE_BYTES=1048576
MAX_CONCURRENT_UPLOADS=4
MAX_CONCURRENT_DOWNLOADS=8
LOG_LEVEL=INFO

# CORS Allowed Origins (Comma-separated list of domains or IP addresses)
# Example: http://your-vps-ip:8000,https://drive.yourdomain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
